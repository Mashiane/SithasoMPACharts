{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SithasoMPACharts skill evaluation suite",
  "type": "object",
  "required": ["skill_name", "version", "cases"],
  "properties": {
    "skill_name": { "const": "sithasompacharts" },
    "version": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
