Build1=Default,com.sithaso.energy.dashboard
Group=Default Group
Library1=core
Library2=sithasompacharts
NumberOfFiles=0
ManifestCode='This code will be applied to the manifest file during compilation.~\n~AddManifestText(~\n~<uses-sdk android:minSdkVersion="23" android:targetSdkVersion="35"/>~\n~<supports-screens android:largeScreens="true" android:normalScreens="true" android:smallScreens="true" android:anyDensity="true"/>~\n~)~\n~SetApplicationAttribute(android:label, "$LABEL$")~\n~CreateResourceFromFile(Macro, Themes.LightTheme)~\n~'
Module1=Main
NumberOfLibraries=2
NumberOfModules=1
Version=14.2
@EndOfDesignText@
#region Project Attributes
    #ApplicationLabel: Renewable Energy Dashboard
    #VersionCode: 1
    #VersionName: 1.0
    #SupportedOrientations: portrait
    #AdditionalJar: mpChartLib
    #AdditionalJar: kotlin-stdlib-2.0.21
#End Region

#region Activity Attributes
    #FullScreen: False
    #IncludeTitle: False
#End Region

' Independent dashboard implementation.
' The three charts are designed from the product requirements, not copied from a numbered demo.
' Values below are illustrative sample data, not live telemetry.

Sub Process_Globals
End Sub

Sub Globals
    Private DashboardScroll As ScrollView
    Private ChartMonthly As SithasoMPACharts
    Private ChartSources As SithasoMPACharts
    Private ChartDaily As SithasoMPACharts

    Private Header As Label
    Private SubHeader As Label
End Sub

Private Sub DashboardColor As Int
    Return Colors.RGB(246, 248, 251)
End Sub

Private Sub InkColor As Int
    Return Colors.RGB(24, 39, 58)
End Sub

Private Sub MutedColor As Int
    Return Colors.RGB(91, 105, 122)
End Sub

Sub Activity_Create(FirstTime As Boolean)
    Activity.Color = DashboardColor

    BuildHeader

    DashboardScroll.Initialize(0)
    Activity.AddView(DashboardScroll, 0, 66dip, Activity.Width, Activity.Height - 66dip)
    DashboardScroll.Panel.Color = DashboardColor
    DashboardScroll.Panel.Width = Activity.Width

    BuildDashboard
End Sub

Private Sub BuildHeader
    Header.Initialize("")
    Header.Text = "Renewable Energy"
    Header.TextSize = 22
    Header.TextColor = InkColor
    Header.Typeface = Typeface.DEFAULT_BOLD
    Header.Gravity = Gravity.CENTER_VERTICAL
    Activity.AddView(Header, 16dip, 6dip, Activity.Width - 32dip, 32dip)

    SubHeader.Initialize("")
    SubHeader.Text = "Generation, energy mix and daily demand"
    SubHeader.TextSize = 12
    SubHeader.TextColor = MutedColor
    SubHeader.Gravity = Gravity.CENTER_VERTICAL
    Activity.AddView(SubHeader, 16dip, 36dip, Activity.Width - 32dip, 24dip)
End Sub

Private Sub BuildDashboard
    Dim Top As Int = 10dip
    Dim ChartWidth As Int = Activity.Width - 16dip
    Dim SectionWidth As Int = Activity.Width - 32dip
    Dim ChartHeight As Int = 300dip
    Dim SectionGap As Int = 18dip
    Dim ChartGap As Int = 12dip

    AddSectionTitle("01  Monthly generation", Top)
    Top = Top + 30dip
    ChartMonthly.Initialize("ChartMonthly")
    DashboardScroll.Panel.AddView(ChartMonthly, 8dip, Top, ChartWidth, ChartHeight)
    ConfigureMonthlyChart
    Top = Top + ChartHeight + SectionGap

    AddSectionTitle("02  Generation by source", Top)
    Top = Top + 30dip
    ChartSources.Initialize("ChartSources")
    DashboardScroll.Panel.AddView(ChartSources, 8dip, Top, ChartWidth, ChartHeight)
    ConfigureSourceChart
    Top = Top + ChartHeight + SectionGap

    AddSectionTitle("03  Generation vs consumption", Top)
    Top = Top + 30dip
    ChartDaily.Initialize("ChartDaily")
    DashboardScroll.Panel.AddView(ChartDaily, 8dip, Top, ChartWidth, ChartHeight)
    ConfigureDailyChart
    Top = Top + ChartHeight + ChartGap

    ' Derive content height from the final child position instead of a fixed constant.
    DashboardScroll.Panel.Height = Top
End Sub

Private Sub AddSectionTitle(TextValue As String, Top As Int)
    Dim Section As Label
    Section.Initialize("")
    Section.Text = TextValue
    Section.TextSize = 16
    Section.TextColor = Colors.RGB(31, 48, 68)
    Section.Typeface = Typeface.DEFAULT_BOLD
    Section.Gravity = Gravity.CENTER_VERTICAL
    DashboardScroll.Panel.AddView(Section, 16dip, Top, Activity.Width - 32dip, 28dip)
End Sub

Private Sub ConfigureCommonChart(Chart As SithasoMPACharts, ChartTitle As String, SubtitleText As String, XCaption As String, YCaption As String, LegendMode As Int)
    Chart.BeginUpdate
    Chart.Title = ChartTitle
    Chart.ShowTitle = True
    Chart.Subtitle = SubtitleText
    Chart.ShowSubtitle = True
    Chart.Theme = Chart.THEME_NIGHTFALL
    Chart.BackgroundColor = Colors.White
    Chart.CornerRadius = 10
    Chart.Elevation = 1
    Chart.HeaderPaddingHorizontal = 12
    Chart.HeaderPaddingTop = 8
    Chart.HeaderPaddingBottom = 4
    Chart.XTitle = XCaption
    Chart.YTitle = YCaption
    Chart.LegendEnabled = LegendMode
    Chart.DisableScroll = True
    Chart.AllowZoom = False
    Chart.Animate = True
    Chart.AnimationDuration = 650
End Sub

Private Sub ConfigureMonthlyChart
    ConfigureCommonChart(ChartMonthly, "Energy generated", "Monthly output by generation source (MWh)", "Month", "Generation (MWh)", ChartMonthly.LEGEND_AUTO)
    ChartMonthly.ChartType = ChartMonthly.CHART_LINE
    ChartMonthly.DrawCirclesEnabled = False
    ChartMonthly.LineWidth = 2.5

    Dim SolarSet As Int = ChartMonthly.AddDataSet("Solar", Colors.RGB(245, 158, 11))
    Dim WindSet As Int = ChartMonthly.AddDataSet("Wind", Colors.RGB(14, 165, 233))

    ChartMonthly.AddLabels(Array As String("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"))
    ChartMonthly.AddValues(SolarSet, Array As Double(118, 126, 142, 155, 168, 174, 181, 190, 205, 214, 226, 238))
    ChartMonthly.AddValues(WindSet, Array As Double(92, 105, 112, 108, 116, 129, 138, 145, 151, 148, 157, 166))
    ChartMonthly.EndUpdate
End Sub

Private Sub ConfigureSourceChart
    ConfigureCommonChart(ChartSources, "Annual energy mix", "Total generation by source (MWh)", "Energy source", "Generation (MWh)", ChartSources.LEGEND_HIDE)
    ChartSources.ChartType = ChartSources.CHART_COLUMN
    ChartSources.AxisMinimum = 0
    ChartSources.BarWidth = 0.55
    ChartSources.DrawValues = True
    ChartSources.ValueFontSize = 10

    Dim SolarSet As Int = ChartSources.AddDataSet("Annual generation", Colors.RGB(16, 185, 129))
    ChartSources.AddLabels(Array As String("Solar", "Wind", "Hydro", "Biomass"))
    ChartSources.AddValues(SolarSet, Array As Double(2237, 1517, 1080, 642))
    ChartSources.EndUpdate
End Sub

Private Sub ConfigureDailyChart
    ConfigureCommonChart(ChartDaily, "Daily energy balance", "Generation and consumption (MWh)", "Day", "Energy (MWh)", ChartDaily.LEGEND_AUTO)
    ChartDaily.ChartType = ChartDaily.CHART_LINE
    ChartDaily.DrawCirclesEnabled = True
    ChartDaily.CircleRadius = 3
    ChartDaily.LineWidth = 2.5

    Dim GenerationSet As Int = ChartDaily.AddDataSet("Generation", Colors.RGB(16, 185, 129))
    Dim ConsumptionSet As Int = ChartDaily.AddDataSet("Consumption", Colors.RGB(99, 102, 241))

    ChartDaily.AddLabels(Array As String("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"))
    ChartDaily.AddValues(GenerationSet, Array As Double(182, 195, 201, 188, 215, 230, 221))
    ChartDaily.AddValues(ConsumptionSet, Array As Double(176, 184, 210, 194, 205, 218, 225))
    ChartDaily.EndUpdate
End Sub

Sub Activity_Resume
End Sub

Sub Activity_Pause (UserClosed As Boolean)
End Sub
