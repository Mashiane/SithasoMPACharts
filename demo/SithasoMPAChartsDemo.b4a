#region Project Attributes
    #ApplicationLabel: SithasoMPACharts Demo
    #VersionCode: 1
    #VersionName: 2.0
    #SupportedOrientations: portrait
    #AdditionalJar: mpChartLib
    #AdditionalJar: kotlin-stdlib-2.0.21
#End Region

#region Activity Attributes
    #FullScreen: False
    #IncludeTitle: False
#End Region

Sub Process_Globals
End Sub

Sub Globals
    Private Examples As ListView
    Private Header As Label
    Private Acts As List
End Sub

Sub Activity_Create(FirstTime As Boolean)
    Activity.Color = Colors.RGB(247, 248, 250)
    Header.Initialize("")
    Header.Text = "SithasoMPACharts examples"
    Header.TextSize = 24
    Header.TextColor = Colors.RGB(27, 38, 59)
    Header.Gravity = Gravity.CENTER_VERTICAL
    Activity.AddView(Header, 18dip, 30dip, Activity.Width - 36dip, 52dip)

    Examples.Initialize("Examples")
    Examples.SingleLineLayout.Label.TextSize = 17
    Examples.SingleLineLayout.Label.TextColor = Colors.RGB(35, 47, 62)
    Examples.SingleLineLayout.ItemHeight = 52dip
    Activity.AddView(Examples, 10dip, 92dip, Activity.Width - 20dip, Activity.Height - 120dip)


    Dim Names As List = Array As String( _
        "Line", "Area", "Column", "Bar", "Pie", "Donut", "Scatter", "Bubble", "Radar", "Candlestick", "Combo", _
        "Nightingale rose", "Polar area", "Half donut gauge", _
        "Grouped columns", "Stacked columns", "Stacked bars", "Value alignment", "Pill stacked columns", "Pill stacked bars", "Pill columns", "Multiple series", "Scatter coordinates", "Series colors", _
        "Data values", "Currency prefix", "Axis limits", "Limit lines", "Straight line", "Dashed lines", "No grid", _
        "Pan and zoom off", "Custom palette", "Legend hidden", "Legend at bottom", "Legend at top", _
        "Dual Y-Axis", "Positive negative column", "Negative horizontal bar", "Stepped line", "Sine wave bars", _
        "Scatter shapes", "High density line", "24-Hour timeline", "Rotated labels", "Title and subtitle", _
        "Single series colors", "Multi-line straight", "Multi-series area", "Multi-series gradient", "Empty state", _
        "Animate X and Y", "Animate XY columns", "Realtime streaming", _
        "Nightfall: Revenue", "Nightfall: Orders", "Nightfall: Budget", "Nightfall: Sessions", _
        "Nightfall: Spend", "Nightfall: ACME Corp", "Nightfall: Team profile", "Nightfall: Growth", "Nightfall: Deal size", _
        "Cyberpunk: Revenue", "Cyberpunk: Orders", "Cyberpunk: Budget", "Cyberpunk: Sessions", _
        "Cyberpunk: Spend", "Cyberpunk: ACME Corp", "Cyberpunk: Team profile", "Cyberpunk: Growth", "Cyberpunk: Deal size", _
        "Material: Revenue", "Material: Orders", "Material: Budget", "Material: Sessions", _
        "Material: Spend", "Material: ACME Corp", "Material: Team profile", "Material: Growth", "Material: Deal size", _
        "Pastel: Revenue", "Pastel: Orders", "Pastel: Budget", "Pastel: Sessions", _
        "Pastel: Spend", "Pastel: ACME Corp", "Pastel: Team profile", "Pastel: Growth", "Pastel: Deal size", _
        "Liberty: Revenue", "Liberty: Orders", "Liberty: Budget", "Liberty: Sessions", _
        "Liberty: Spend", "Liberty: ACME Corp", "Liberty: Team profile", "Liberty: Growth", "Liberty: Deal size", _
        "Nightfall Dark: Revenue", "Nightfall Dark: Orders", "Nightfall Dark: Budget", "Nightfall Dark: Sessions", _
        "Nightfall Dark: Spend", "Nightfall Dark: ACME Corp", "Nightfall Dark: Team profile", "Nightfall Dark: Growth", "Nightfall Dark: Deal size", _
        "Radial single", "Radial center image", "Radial bar labels", "Radial gauge label", "Radial single dashed", _
        "Radial dashed gauge", "Radial", "Radial semi", "Radial dashed", "Radial gradient", "Radial gauge", _
        "Easing bounce", "Percent donut", "Slice leaders", "Bar borders", "Combo layers", "Axis chrome", "Candle style", "Radar web", _
        "Challenge 1.1: Hello Chart", "Challenge 1.2: Theme Swap", "Challenge 1.3: Chart Type Picker", _
        "Challenge 2.1: Anatomy Labeler", "Challenge 2.2: Dual Axis Chart", "Challenge 2.3: Radial Gauge Anatomy")

    For i = 0 To Names.Size - 1
        Examples.AddSingleLine2((i + 1) & ". " & Names.Get(i), i)
    Next

    ' One activity per chart, launched from the list below.
    Acts.Initialize
    Acts.Add(frmExample001)
    Acts.Add(frmExample002)
    Acts.Add(frmExample003)
    Acts.Add(frmExample004)
    Acts.Add(frmExample005)
    Acts.Add(frmExample006)
    Acts.Add(frmExample007)
    Acts.Add(frmExample008)
